// Copyright 2026 NPU IP
// NPU Compute Core Wrapper
// Buffers 32-bit TCDM reads into 1024-bit vectors to feed the MAC array

`include "npu_compute_core_pkg.sv"

module npu_core_wrapper import npu_compute_core_pkg::*; #(
  parameter int CoreId = 0,
  parameter int TcdmAddrWidth = 32,
  parameter int TcdmDataWidth = 32
)(
  input  logic clk_i,
  input  logic rst_ni,

  // MMIO Control Interface
  input  logic                    mmio_req_valid_i,
  input  logic                    mmio_req_write_i,
  input  logic [31:0]             mmio_req_addr_i,
  input  logic [31:0]             mmio_req_data_i,
  output logic                    mmio_req_ready_o,
  output logic                    mmio_rsp_valid_o,
  output logic [31:0]             mmio_rsp_data_o,

  // TCDM Master Interface
  output logic                    tcdm_req_valid_o,
  output logic                    tcdm_req_write_o,
  output logic [3:0]              tcdm_req_be_o,
  output logic [31:0]             tcdm_req_addr_o,
  output logic [31:0]             tcdm_req_wdata_o,
  input  logic                    tcdm_req_ready_i,
  input  logic                    tcdm_rsp_valid_i,
  input  logic [31:0]             tcdm_rsp_rdata_i
);

  // MMIO Registers
  logic [31:0] reg_ctrl;
  logic [31:0] reg_act_ptr;
  logic [31:0] reg_wgt_ptr;
  logic [31:0] reg_out_ptr;
  logic [31:0] reg_stride_slide;
  logic [15:0] reg_img_width;
  logic [7:0]  reg_kernel_size;
  logic [7:0]  reg_stride;

  // Local Buffers
  logic signed [7:0] act_buf [128];
  logic signed [7:0] wgt_buf [128];

  logic core_valid, core_ready, core_out_valid, core_clear_acc;
  logic [31:0] core_out_act;

  core_cfg_t core_cfg;
  assign core_cfg.act_type = act_type_e'(reg_ctrl[10:8]);
  assign core_cfg.output_scale = 1;
  assign core_cfg.output_zero_point = 0;
  assign core_cfg.shift_amount = 0;

  logic [15:0] slide_x_cnt_q, slide_x_cnt_d;
  logic [15:0] out_cnt_q, out_cnt_d;
  logic [31:0] final_out_q, final_out_d;
  logic [31:0] pool_row_q, pool_row_d;
  logic [1:0]  act_offset_q, act_offset_d;

  // MMIO Logic
  assign mmio_req_ready_o = 1'b1;

  logic [31:0] total_cycles;
  logic [31:0] mac_active_cycles;

  always_ff @(posedge clk_i or negedge rst_ni) begin
    if (!rst_ni) begin
      total_cycles <= 0;
      mac_active_cycles <= 0;
    end else begin
      total_cycles <= total_cycles + 1;
      if (core_valid && core_ready) begin
        mac_active_cycles <= mac_active_cycles + 1;
      end
    end
  end

  // FSM for fetching
  typedef enum logic [2:0] { IDLE, FETCH_ACT, FETCH_WGT, COMPUTE, WAIT_OUT, WRITE_OUT } state_e;
  state_e state_q, state_d;

  logic [31:0] act_ptr_q, act_ptr_d;
  logic [31:0] wgt_ptr_q, wgt_ptr_d;
  logic [7:0]  fetch_cnt_q, fetch_cnt_d; // up to 32 words
  logic [31:0] slide_idx_q, slide_idx_d;

  npu_compute_core i_core (
    .clk_i(clk_i),
    .rst_ni(rst_ni),
    .cfg_i(core_cfg),
    .valid_i(core_valid),
    .clear_acc_i(core_clear_acc),
    .act_i(act_buf),
    .wgt_i(wgt_buf),
    .ready_o(core_ready),
    .valid_o(core_out_valid),
    .act_o(core_out_act),
    .ready_i(1'b1)
  );

  always_ff @(posedge clk_i or negedge rst_ni) begin
    if (!rst_ni) begin
      mmio_rsp_valid_o <= 0;
      mmio_rsp_data_o <= 0;
      reg_ctrl <= 0;
      reg_act_ptr <= 0;
      reg_wgt_ptr <= 0;
      reg_out_ptr <= 0;
      reg_stride_slide <= 0;
      reg_img_width <= 0;
      reg_kernel_size <= 0;
      reg_stride <= 0;
    end else begin
      mmio_rsp_valid_o <= 0;
      if (mmio_req_valid_i && mmio_req_ready_o) begin
        mmio_rsp_valid_o <= 1;
        if (mmio_req_write_i) begin
          case (mmio_req_addr_i[7:0])
            8'h00: reg_act_ptr <= mmio_req_data_i;
            8'h04: reg_wgt_ptr <= mmio_req_data_i;
            8'h08: reg_out_ptr <= mmio_req_data_i;
            8'h0C: reg_stride_slide <= mmio_req_data_i;
            8'h10: reg_img_width <= mmio_req_data_i[15:0];
            8'h14: reg_kernel_size <= mmio_req_data_i[7:0];
            8'h18: reg_stride <= mmio_req_data_i[7:0];
            8'h1C: reg_ctrl <= mmio_req_data_i;
          endcase
        end else begin
          case (mmio_req_addr_i[7:0])
            8'h00: mmio_rsp_data_o <= reg_act_ptr;
            8'h04: mmio_rsp_data_o <= reg_wgt_ptr;
            8'h08: mmio_rsp_data_o <= reg_out_ptr;
            8'h0C: mmio_rsp_data_o <= reg_stride_slide;
            8'h10: mmio_rsp_data_o <= {16'd0, reg_img_width};
            8'h14: mmio_rsp_data_o <= {24'd0, reg_kernel_size};
            8'h18: mmio_rsp_data_o <= {24'd0, reg_stride};
            8'h1C: mmio_rsp_data_o <= reg_ctrl;
            8'h20: mmio_rsp_data_o <= {4'h0, state_q, slide_idx_q[11:0], out_cnt_q[11:0]};
            8'h24: mmio_rsp_data_o <= mac_active_cycles;
            8'h28: mmio_rsp_data_o <= total_cycles;
            default: mmio_rsp_data_o <= 32'hDEADBEEF;
          endcase
        end
      end
    end
  end

  always_ff @(posedge clk_i or negedge rst_ni) begin
    if (!rst_ni) begin
      state_q <= IDLE;
      act_ptr_q <= 0;
      wgt_ptr_q <= 0;
      fetch_cnt_q <= 0;
      slide_idx_q <= 0;
      final_out_q <= 0;
      slide_x_cnt_q <= 0;
      out_cnt_q <= 0;
      pool_row_q <= 0;
      act_offset_q <= 0;
    end else begin
      state_q <= state_d;
      act_ptr_q <= act_ptr_d;
      wgt_ptr_q <= wgt_ptr_d;
      fetch_cnt_q <= fetch_cnt_d;
      slide_idx_q <= slide_idx_d;
      final_out_q <= final_out_d;
      slide_x_cnt_q <= slide_x_cnt_d;
      out_cnt_q <= out_cnt_d;
      pool_row_q <= pool_row_d;
      act_offset_q <= act_offset_d;
    end
  end

  always_ff @(posedge clk_i) begin
    if (tcdm_rsp_valid_i && state_q == FETCH_ACT) begin
      if (reg_ctrl[10:8] == 7) begin
        automatic int base_idx = (fetch_cnt_q - 1) * 4;
        act_buf[base_idx + 0] <= tcdm_rsp_rdata_i[7:0];
        act_buf[base_idx + 1] <= tcdm_rsp_rdata_i[15:8];
        act_buf[base_idx + 2] <= tcdm_rsp_rdata_i[23:16];
        act_buf[base_idx + 3] <= tcdm_rsp_rdata_i[31:24];
      end else begin
        automatic int base_idx = (fetch_cnt_q - 1) * 4;
        act_buf[base_idx + 0] <= tcdm_rsp_rdata_i[7:0];
        act_buf[base_idx + 1] <= tcdm_rsp_rdata_i[15:8];
        act_buf[base_idx + 2] <= tcdm_rsp_rdata_i[23:16];
        act_buf[base_idx + 3] <= tcdm_rsp_rdata_i[31:24];
      end
    end else if (tcdm_rsp_valid_i && state_q == FETCH_WGT) begin
      automatic int base_idx = (fetch_cnt_q - 1) * 4;
      wgt_buf[base_idx + 0] <= tcdm_rsp_rdata_i[7:0];
      wgt_buf[base_idx + 1] <= tcdm_rsp_rdata_i[15:8];
      wgt_buf[base_idx + 2] <= tcdm_rsp_rdata_i[23:16];
      wgt_buf[base_idx + 3] <= tcdm_rsp_rdata_i[31:24];
    end
  end

  always_comb begin
    state_d = state_q;
    act_ptr_d = act_ptr_q;
    wgt_ptr_d = wgt_ptr_q;
    fetch_cnt_d = fetch_cnt_q;
    slide_idx_d = slide_idx_q;
    final_out_d = final_out_q;
    slide_x_cnt_d = slide_x_cnt_q;
    out_cnt_d = out_cnt_q;
    pool_row_d = pool_row_q;
    act_offset_d = act_offset_q;

    tcdm_req_valid_o = 0;
    tcdm_req_write_o = 0;
    tcdm_req_be_o = 4'h0;
    tcdm_req_addr_o = 0;
    tcdm_req_wdata_o = 0;

    core_valid = 0;
    core_clear_acc = 0;

    case (state_q)
      IDLE: begin
        if (reg_ctrl[0]) begin // Trigger
          state_d = FETCH_ACT;
          act_ptr_d = reg_act_ptr;
          wgt_ptr_d = reg_wgt_ptr;
          fetch_cnt_d = 0;
          slide_idx_d = 0;
          slide_x_cnt_d = 0;
          out_cnt_d = 0;
          pool_row_d = 0;
          act_offset_d = act_ptr_d[1:0];
        end
      end

      FETCH_ACT: begin
        if (reg_ctrl[10:8] == 7) begin // ACT_POOL
          automatic logic [15:0] ks = reg_kernel_size;
          if (fetch_cnt_q < words_to_fetch) begin
            automatic logic [31:0] relative_offset = fetch_cnt_q * 4;
            automatic logic [31:0] window_row = relative_offset / ks;
            automatic logic [31:0] window_col = relative_offset % ks;
            automatic logic [31:0] current_act_addr = reg_act_ptr + 
                                  (pool_row_q * reg_img_width) + slide_x_cnt_q + 
                                  (window_row * reg_img_width) + window_col;
            tcdm_req_valid_o = 1;
            tcdm_req_addr_o = {current_act_addr[31:2], 2'b00}; 

            if (tcdm_req_ready_i) begin
              fetch_cnt_d = fetch_cnt_q + 1;
            end
          end else begin
            state_d = COMPUTE;
          end
        end else begin
          if (fetch_cnt_q < 8) begin // 32 bytes
             
            tcdm_req_addr_o = act_ptr_q;
            if (tcdm_req_ready_i) begin
              act_ptr_d = act_ptr_q + 4;
              fetch_cnt_d = fetch_cnt_q + 1;
            end
          end else begin
            state_d = FETCH_WGT;
            fetch_cnt_d = 0;
          end
        end
      end

      FETCH_WGT: begin
        if (fetch_cnt_q < 32) begin // 128 bytes
           
          tcdm_req_addr_o = wgt_ptr_q;
          if (tcdm_req_ready_i) begin
            wgt_ptr_d = wgt_ptr_q + 4;
            fetch_cnt_d = fetch_cnt_q + 1;
          end
        end else begin
          state_d = COMPUTE;
        end
      end

      COMPUTE: begin
        core_valid = 1;
        core_clear_acc = (slide_idx_q == 0); // clear acc ONLY on first slide
        if (core_ready) begin
          if (reg_ctrl[10:8] == 7) begin // ACT_POOL
            state_d = WAIT_OUT;
          end else begin
            automatic logic [15:0] max_slides = reg_stride_slide[15:0]; // MatMul uses lower 16 bits!
            if (max_slides == 0) max_slides = 1;
            
            if (slide_idx_q < max_slides - 1) begin
              slide_idx_d = slide_idx_q + 1;
              fetch_cnt_d = 0;
              state_d = FETCH_ACT; // go fetch next block
            end else begin
              state_d = WAIT_OUT;
            end
          end
        end
      end

      WAIT_OUT: begin
        if (core_out_valid) begin
          final_out_d = core_out_act;
          if (reg_ctrl[2]) begin // write_out bit
            state_d = WRITE_OUT;
          end else begin
            state_d = IDLE;
          end
        end
      end

      WRITE_OUT: begin
         
        tcdm_req_write_o = 1;
        
        if (reg_ctrl[10:8] == 7) begin // ACT_POOL
            automatic logic [1:0] byte_offset = out_cnt_q[1:0];
            if (byte_offset == 0) tcdm_req_be_o = 4'b0001;
            else if (byte_offset == 1) tcdm_req_be_o = 4'b0010;
            else if (byte_offset == 2) tcdm_req_be_o = 4'b0100;
            else tcdm_req_be_o = 4'b1000;
            
            tcdm_req_wdata_o = {4{final_out_q[7:0]}};
            tcdm_req_addr_o = reg_out_ptr + {out_cnt_q[15:2], 2'b00};
        end else begin
            tcdm_req_be_o = 4'hF;
            tcdm_req_wdata_o = final_out_q;
            tcdm_req_addr_o = reg_out_ptr + {slide_idx_q[15:2], 2'b00}; // wait, slide_idx_q here? No, slide_idx_q is max_slides-1 for MatMul. Output is ALWAYS 1 word at reg_out_ptr.
        end

        if (tcdm_req_ready_i) begin
          if (reg_ctrl[10:8] == 7) begin // ACT_POOL
            automatic logic [15:0] max_slides = reg_stride_slide[31:16]; // MaxPool uses upper 16 bits!
            automatic logic [15:0] out_w = reg_stride_slide[15:0];
            if (max_slides == 0) max_slides = 1;
            if (out_w == 0) out_w = 1;
            
            if (slide_idx_q < max_slides - 1) begin
              slide_idx_d = slide_idx_q + 1;
              out_cnt_d = out_cnt_q + 1;
              
              if (slide_x_cnt_q + reg_stride >= reg_img_width) begin
                  slide_x_cnt_d = 0;
                  pool_row_d = pool_row_q + reg_stride;
              end else begin
                  slide_x_cnt_d = slide_x_cnt_q + reg_stride;
              end
              
              fetch_cnt_d = 0;
              state_d = FETCH_ACT; // go fetch next window
            end else begin
              state_d = IDLE;
            end
          end else begin // For MatMul/Mish/etc, we just wrote the final accumulated result. Return to IDLE!
            state_d = IDLE;
          end
        end
      end
    endcase
  end

endmodule
